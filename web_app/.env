# Financial Planner Application Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key-here>

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
APP_PORT=5000
APP_HOST=0.0.0.0

# ============================================================================
# MCP SERVERS - MARKET DATA CONFIGURATION
# ============================================================================
# Alpha Vantage API for stock prices and market data
# Get free API key from: https://www.alphavantage.co/
# Provides: Stock prices, portfolio performance, market indices
MARKET_DATA_PROVIDER=yfinance

# Alternative: IEX Cloud API (if you prefer this provider)
# Get free account from: https://iexcloud.io/
# MARKET_DATA_PROVIDER=iex_cloud
# IEX_CLOUD_API_KEY=your_iex_cloud_api_key_here

# ============================================================================
# MCP SERVERS - FEDERAL RESERVE ECONOMIC DATA (FRED)
# ============================================================================
# Free API for economic indicators: inflation, unemployment, interest rates, GDP
# Get free API key from: https://fred.stlouisfed.org/docs/api/
# Provides: Inflation rates, unemployment, Fed Funds Rate, mortgage rates, GDP data
FRED_API_KEY=<your-fred-api-key-here>

# ============================================================================
# MCP SERVERS - MORTGAGE RATES (OPTIONAL)
# ============================================================================
# Optional mortgage rates API if using external service beyond FRED data
# MORTGAGE_API_KEY=your_mortgage_api_key_here

# ============================================================================
# MCP SERVERS - GENERAL SETTINGS
# ============================================================================
# Enable/disable MCP server functionality
ENABLE_MCP_SERVERS=true

# Enable caching of MCP responses to reduce API calls
MCP_CACHE_ENABLED=true

# Cache timeout in seconds (default: 300 = 5 minutes)
MCP_CACHE_TIMEOUT=300
